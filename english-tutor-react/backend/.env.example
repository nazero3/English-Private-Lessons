# Backend (FastAPI)
# Local manual dev (host Postgres on port 5434 — see docs/DEPLOY.md)
# DATABASE_URL=postgresql://lessons:lessons@localhost:5434/lessons
# Docker Compose (api container → db service):
DATABASE_URL=postgresql://lessons:lessons@db:5432/lessons
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRE_HOURS=72
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_USERS=true

# Postgres (docker-compose)
POSTGRES_USER=lessons
POSTGRES_PASSWORD=lessons
POSTGRES_DB=lessons
